/*
 * Shared by every ezeco device. The dongle owns the keymap, so the transform and
 * the split/sensor nodes must exist identically on all four builds.
 */

#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zmk,matrix-transform = &default_transform;
    };

    /*
     * Matrix: rows 0-6 x cols 0-6 per half (Lemon wireless: 7 GPIO rows, 7 shift-register
     * columns), right half shifted by col-offset 7, mouse in rows 7-9 (row-offset 7).
     *
     * PROVISIONAL: the per-key RC() values for the halves depend on how the Pumpkin PCBs are
     * chained, which Cosmos computes from the model. Replace the first 43 entries with the
     * `default_transform` map from the Cosmos ZMK export of the final model, keeping the key
     * order documented in config/ezeco.keymap.
     */
    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        rows = <10>;
        columns = <14>;
        map = <
// Fingers: left pinky..inner, right inner..pinky
RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4)    RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11)
RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4)    RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11)
RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4)    RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11)
// Extra bottom keys (middle, index columns)
                RC(3,2) RC(3,3)            RC(3,8) RC(3,9)
// Thumbs: left 5, right 4
RC(4,0) RC(4,1) RC(4,2) RC(4,3) RC(4,4)    RC(4,7) RC(4,8) RC(4,9) RC(4,10)
// Mouse: left, right, middle, back, forward, DPI, tilt left, tilt right
RC(7,0) RC(7,1) RC(7,2) RC(8,0) RC(8,1) RC(8,2) RC(9,0) RC(9,1)
        >;
    };

    /*
     * Pointing devices on peripherals, forwarded to the dongle. Disabled here: each
     * peripheral enables only its own split (with `device`), the dongle enables both.
     */
    split_inputs {
        #address-cells = <1>;
        #size-cells = <0>;

        trackball_split: trackball_split@0 {
            compatible = "zmk,input-split";
            reg = <0>;
            status = "disabled";
        };

        mouse_split: mouse_split@1 {
            compatible = "zmk,input-split";
            reg = <1>;
            status = "disabled";
        };
    };

    /* Mouse scroll wheel. Enabled only in ezeco_mouse.overlay. */
    scroll_encoder: scroll_encoder {
        compatible = "alps,ec11";
        a-gpios = <&gpio0 9 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        b-gpios = <&gpio0 10 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        steps = <96>;
        status = "disabled";
    };

    sensors: sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&scroll_encoder>;
        triggers-per-rotation = <24>;
    };
};
