/*
 * ezeco keymap, ported from ezboard (Colemak-DH). Lives on the dongle.
 *
 * Key order (51 positions, matches default_transform in ezeco.dtsi):
 *   3 finger rows       left pinky..inner (5)   right inner..pinky (5)
 *   extra bottom keys   left middle, index (2)  right index, middle (2)
 *   thumbs              left outer..inner (5)   right inner..outer (4)
 *   mouse               L, R, M, back, forward, DPI, tilt left, tilt right (8)
 *
 * Layer switching keeps the ezboard style (&to). Left inner thumb and right inner
 * thumb are the layer keys on every layer.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE 0
#define SYM  1
#define NAV  2
#define FUN  3
#define GAME 4
#define GNUM 5

// Mouse buttons are the same on every layer. DPI button: TODO once the CPI behaviour is chosen.
#define MOUSE &mkp LCLK &mkp RCLK &mkp MCLK &mkp MB4 &mkp MB5 &none &msc SCRL_LEFT &msc SCRL_RIGHT

/ {
    behaviors {
        // Mouse wheel. TODO: tune feel in step M2 (may move to an input processor instead).
        scroll_wheel: scroll_wheel {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "Base";
            bindings = <
&kp Q  &kp W  &kp F  &kp P  &kp B        &kp J  &kp L  &kp U      &kp Y    &kp SEMI
&kp A  &kp R  &kp S  &kp T  &kp G        &kp M  &kp N  &kp E      &kp I    &kp O
&kp Z  &kp X  &kp C  &kp D  &kp V        &kp K  &kp H  &kp COMMA  &kp DOT  &kp FSLH
              &kp LWIN  &kp ESC          &kp SQT  &kp DEL
&kp TAB  &kp LCTRL  &kp LSHIFT  &kp SPACE  &to NAV        &to SYM  &kp RET  &kp BSPC  &kp RALT
MOUSE
            >;
            sensor-bindings = <&scroll_wheel>;
        };

        sym_layer {
            display-name = "Sym";
            bindings = <
&kp EXCL  &kp AT    &kp HASH  &kp DLLR  &kp PRCNT    &kp EQUAL  &kp N7  &kp N8  &kp N9  &kp PLUS
&kp BSLH  &kp PIPE  &kp LBRC  &kp LPAR  &kp LBKT     &kp ASTRK  &kp N4  &kp N5  &kp N6  &kp MINUS
&kp CARET &kp AMPS  &kp RBRC  &kp RPAR  &kp RBKT     &kp N0     &kp N1  &kp N2  &kp N3  &kp FSLH
                    &kp LWIN  &kp ESC                &kp UNDER  &kp DEL
&kp TAB  &kp LCTRL  &kp LSHIFT  &kp SPACE  &to BASE       &to FUN  &kp RET  &kp BSPC  &none
MOUSE
            >;
            sensor-bindings = <&scroll_wheel>;
        };

        nav_layer {
            display-name = "Nav";
            bindings = <
&none  &none  &none  &none  &none        &none  &none     &kp PG_UP  &kp PG_DN  &none
&none  &none  &none  &none  &none        &none  &kp LEFT  &kp UP     &kp DOWN   &kp RIGHT
&none  &none  &none  &none  &none        &none  &none     &none      &none      &none
              &kp LWIN  &none            &none  &none
&none  &none  &none  &none  &to BASE        &to SYM  &kp RET  &none  &none
MOUSE
            >;
            sensor-bindings = <&scroll_wheel>;
        };

        function_layer {
            display-name = "Fun";
            bindings = <
&kp F1  &kp F2   &kp F3   &kp F4   &none     &kp C_PLAY  &kp C_PREV     &kp C_NEXT     &kp PSCRN  &none
&kp F5  &kp F6   &kp F7   &kp F8   &none     &kp C_MUTE  &kp C_VOL_DN   &kp C_VOL_UP   &none      &none
&kp F9  &kp F10  &kp F11  &kp F12  &none     &none       &none          &none          &none      &none
                 &bt BT_CLR  &bt BT_NXT      &bt BT_PRV  &sys_reset
&none  &none  &kp LCTRL  &none  &to BASE        &to GAME  &none  &kp RALT  &none
MOUSE
            >;
            sensor-bindings = <&scroll_wheel>;
        };

        gaming_layer {
            display-name = "Game";
            bindings = <
&kp TAB     &kp Q  &kp W  &kp E  &kp R      &kp Y  &kp U  &kp I      &kp O    &kp P
&kp LSHIFT  &kp A  &kp S  &kp D  &kp F      &kp H  &kp J  &kp K      &kp L    &kp SEMI
&kp LCTRL   &kp Z  &kp X  &kp C  &kp V      &kp N  &kp M  &kp COMMA  &kp DOT  &kp FSLH
                   &kp ESC  &none           &kp RCTRL  &none
&none  &none  &kp LALT  &kp SPACE  &mo GNUM        &to BASE  &none  &none  &none
MOUSE
            >;
            sensor-bindings = <&scroll_wheel>;
        };

        gaming_num_layer {
            display-name = "Game Num";
            bindings = <
&none  &kp N1  &kp N2  &kp N3  &none      &none  &none  &none  &none  &none
&none  &kp N4  &kp N5  &kp N6  &none      &none  &none  &none  &none  &none
&none  &kp N7  &kp N8  &kp N9  &kp N0     &none  &none  &none  &none  &none
               &none   &none              &none  &none
&none  &none  &none  &none  &none        &none  &none  &none  &none
MOUSE
            >;
            sensor-bindings = <&scroll_wheel>;
        };
    };
};
